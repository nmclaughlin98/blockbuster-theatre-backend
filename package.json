{
    "name": "blockbuster-theatre-backend",
    "version": "2.1.2",
    "private": true,
    "engines": {
        "node": ">=24.0.0"
    },
    "scripts": {
        "build": "node scripts/build.mjs",
        "build:verbose": "tsc --diagnostics",
        "watch": "tsc -w",
        "pretest": "npm run docs:build",
        "test": "jest --runInBand",
        "docs:build": "node scripts/build-api-docs.cjs",
        "docs:check": "node scripts/check-api-docs.cjs",
        "cdk": "cdk",
        "lint": "eslint .",
        "lint:fix": "prettier --write . && eslint . --fix",
        "presynth": "npm run docs:build",
        "synth": "cdk synth",
        "predeploy": "npm run docs:build",
        "deploy": "cdk deploy",
        "destroy": "cdk destroy",
        "pretest:watch": "npm run docs:build",
        "test:watch": "jest --watch --runInBand",
        "pretest:coverage": "npm run docs:build",
        "test:coverage": "jest --coverage --runInBand",
        "seed:pricing": "ts-node scripts/seed-pricing-offers.ts",
        "migrate:movie-image-urls": "ts-node scripts/migrate-movie-image-urls.ts",
        "migrate:showtime-registry": "ts-node scripts/migrate-showtime-registry.ts",
        "migrate:movie-showtimes": "ts-node scripts/migrate-movie-showtimes.ts",
        "sync:dev": "ts-node scripts/sync-prod-to-dev.ts",
        "update:movie-showtimes": "ts-node scripts/update-movie-showtimes.ts",
        "update:offer-showtimes": "ts-node scripts/update-offer-showtimes.ts",
        "local:db:start": "docker compose up -d dynamodb-local",
        "local:db:stop": "docker compose stop dynamodb-local",
        "local:init": "ts-node scripts/init-local-db.ts",
        "local:api": "ts-node scripts/local-api.ts",
        "local:cloud": "ts-node scripts/local-api.ts --cloud-db",
        "local": "npm run local:db:start && npm run local:init && npm run local:api"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@redocly/cli": "^2.83.0",
        "@smithy/util-stream": "^4.7.0",
        "@stylistic/eslint-plugin": "^6.0.1",
        "@swc/core": "^1.16.22",
        "@swc/jest": "^0.2.39",
        "@types/aws-lambda": "^8.10.130",
        "@types/jest": "^30.0.0",
        "@types/node": "^24.19.4",
        "@types/pdfkit": "^0.17.7",
        "@types/qrcode": "^1.5.6",
        "aws-cdk": "^2.1146.1",
        "aws-sdk-client-mock": "^3.0.0",
        "esbuild": "^0.28.1",
        "eslint": "^10.15.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-jsonc": "^3.4.2",
        "globals": "^17.14.0",
        "jest": "^29.7.0",
        "prettier": "^3.10.1",
        "redoc": "^2.5.3",
        "ts-jest": "^29.1.0",
        "ts-node": "^10.9.1",
        "typescript": "^5.3.0",
        "typescript-eslint": "^8.74.0"
    },
    "dependencies": {
        "@aws-sdk/client-cognito-identity-provider": "^3.1156.0",
        "@aws-sdk/client-dynamodb": "^3.500.0",
        "@aws-sdk/client-s3": "^3.1164.0",
        "@aws-sdk/client-sesv2": "^3.1154.0",
        "@aws-sdk/lib-dynamodb": "^3.500.0",
        "aws-cdk-lib": "^2.274.0",
        "constructs": "^10.3.0",
        "dotenv": "^18.0.10",
        "pdfkit": "^0.20.2",
        "qrcode": "^1.5.4"
    },
    "overrides": {
        "brace-expansion": "^5.0.12"
    }
}