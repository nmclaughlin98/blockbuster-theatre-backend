{
  "name": "blockbuster-theatre-backend",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest",
    "cdk": "cdk",
    "synth": "cdk synth",
    "deploy": "cdk deploy",
    "destroy": "cdk destroy",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "seed:pricing": "ts-node scripts/seed-pricing-offers.ts",
    "migrate:movie-image-urls": "ts-node scripts/migrate-movie-image-urls.ts",
    "local:db:start": "docker compose up -d dynamodb-local",
    "local:db:stop": "docker compose stop dynamodb-local",
    "local:init": "ts-node scripts/init-local-db.ts",
    "local:api": "ts-node scripts/local-api.ts",
    "local:cloud": "ts-node scripts/local-api.ts --cloud-db",
    "local": "npm run local:db:start && npm run local:init && npm run local:api"
  },
  "devDependencies": {
    "@swc/core": "^1.3.0",
    "@swc/jest": "^0.2.29",
    "@types/aws-lambda": "^8.10.130",
    "@types/jest": "^29.5.0",
    "@types/node": "24.x",
    "aws-cdk": "^2.130.0",
    "aws-sdk-client-mock": "^3.0.0",
    "esbuild": "^0.28.1",
    "jest": "^29.0.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.500.0",
    "@aws-sdk/lib-dynamodb": "^3.500.0",
    "aws-cdk-lib": "^2.263.0",
    "constructs": "^10.3.0"
  },
  "overrides": {
    "brace-expansion": "^5.0.9"
  }
}
